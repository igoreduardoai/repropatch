# Copy to .env. Never commit secrets. setup.py generates the operator token.
REPROPATCH_AUTH_TOKEN=
REPROPATCH_DATA_DIR=.data
REPROPATCH_ENABLE_LIVE=false
META_MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-wonder-1.0
REPROPATCH_BATCH_CAP_USD=24.00
REPROPATCH_RUN_CAP_USD=3.00

# Separate HMAC key for reviewed case acceptance; generated by setup.
REPROPATCH_ACCEPTANCE_KEY=

# Optional advisory auditor (Meta open-weight Muse Spark Open via Baseten).
# Off unless REPROPATCH_ENABLE_AUDITOR=true; no key = DISABLED (labeled).
REPROPATCH_ENABLE_AUDITOR=false
BASETEN_API_KEY=
REPROPATCH_AUDITOR_CAP_USD=3.00
